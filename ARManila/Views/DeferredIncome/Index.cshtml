@model ARManila.Models.OtherDTO.DeferredIncomeListDTO
@{
    ViewBag.Title = "Deferred Income";
}
<nav class="breadcrumb push bg-body-extra-light rounded-pill">
    <span class="breadcrumb-item">Finance</span>
    <span class="breadcrumb-item active">Deferred Income</span>
</nav>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}
@if (ViewBag.Message != null)
{
    <div class="alert alert-success">@ViewBag.Message</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">@(Model != null ? Model.PeriodName : "")</h3>
    <div>
        <a href="@Url.Action("Summary")" class="btn btn-alt-secondary">Summary</a>
        <a href="@Url.Action("Generate")" class="btn btn-primary">New / Generate</a>
    </div>
</div>

<div class="block block-rounded">
    <div class="block-content">
        @if (Model == null || Model.Batches.Count == 0)
        {
            <p class="text-muted">No deferred income has been generated for this period yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr class="bg-gray-light">
                            <th>Posting Date</th>
                            <th class="text-center">Departments</th>
                            <th class="text-center">Month</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Total Posted</th>
                            <th>Generated</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var batch in Model.Batches)
                        {
                            <tr>
                                <td>@batch.PostingDate.ToString("MMMM dd, yyyy")</td>
                                <td class="text-center">@batch.DepartmentCount</td>
                                <td class="text-center">@batch.NthMonth / @batch.NoOfMonths</td>
                                <td class="text-center">
                                    @if (batch.AllFinal)
                                    {
                                        <span class="badge bg-danger">Final</span>
                                    }
                                    else if (batch.AnyFinal)
                                    {
                                        <span class="badge bg-warning">@batch.FinalCount of @batch.DepartmentCount final</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Draft</span>
                                    }
                                </td>
                                <td align="right">@batch.TotalPosted.ToString("#,##0.00")</td>
                                <td>@batch.DateGenerated.ToString("MM/dd/yyyy hh:mm tt")<br /><small class="text-muted">@batch.GeneratedBy</small></td>
                                <td class="text-center">
                                    <a href="@Url.Action("Details", new { date = batch.PostingDate.ToString("yyyy-MM-dd") })" class="btn btn-sm btn-alt-primary">Details</a>
                                    <a href="@Url.Action("Print", new { date = batch.PostingDate.ToString("yyyy-MM-dd") })" class="btn btn-sm btn-alt-secondary" target="_blank">PDF</a>
                                    @if (!batch.AnyFinal)
                                    {
                                        using (Html.BeginForm("Delete", "DeferredIncome", FormMethod.Post, new { @class = "d-inline-block" }))
                                        {
                                            <input type="hidden" name="date" value="@batch.PostingDate.ToString("yyyy-MM-dd")" />
                                            <button type="submit" class="btn btn-sm btn-alt-danger" title="Delete" onclick="return confirm('Delete deferred income for @batch.PostingDate.ToString("MMMM dd, yyyy")? This cannot be undone.');">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
