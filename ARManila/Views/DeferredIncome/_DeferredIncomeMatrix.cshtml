@model ARManila.Models.OtherDTO.DeferredIncomeQueryDTO
@{
    int deptCount = Model.Columns.Count;
    int groupCols = deptCount + 1;         // depts + group total
    int fullCols = groupCols * 2 + 1;      // description + actual group + deferred group
}

<style>
    .di-group-sep { border-left: 2px solid #adb5bd !important; }
</style>

<div class="table-responsive">
    <table class="table table-striped table-bordered table-hover">
        <caption style="caption-side: top; text-align: center; font-weight: 600; color: inherit; font-size: 1rem;">
            Month @Model.NthMonth of @Model.NoOfMonths
        </caption>
        <thead>
            <tr class="bg-gray-light text-center">
                <th rowspan="2" style="vertical-align: middle;">Fee</th>
                <th colspan="@groupCols" class="di-group-sep">Actual</th>
                <th colspan="@groupCols" class="di-group-sep">Deferred</th>
            </tr>
            <tr class="bg-gray-light text-center">
                @* ---- Actual group headers ---- *@
                @{ bool firstActual = true; }
                @foreach (var col in Model.Columns)
                {
                    <th class="@(firstActual ? "di-group-sep" : "")">
                        @col.Header
                        @if (col.IsFinal)
                        {
                            <span class="badge bg-danger" title="Final">F</span>
                        }
                        else if (col.HasExistingRecord)
                        {
                            <span class="badge bg-warning" title="Draft">O</span>
                        }
                    </th>
                    firstActual = false;
                }
                <th>Total</th>
                @* ---- Deferred group headers ---- *@
                @{ bool firstDeferred = true; }
                @foreach (var col in Model.Columns)
                {
                    <th class="@(firstDeferred ? "di-group-sep" : "")">
                        @col.Header
                        @if (col.IsFinal)
                        {
                            <span class="badge bg-danger" title="Final">F</span>
                        }
                        else if (col.HasExistingRecord)
                        {
                            <span class="badge bg-warning" title="Draft">O</span>
                        }
                    </th>
                    firstDeferred = false;
                }
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model.Categories)
            {
                if (category.IsSectionHeader)
                {
                    <tr class="subtotal">
                        <td colspan="@fullCols">@category.Name</td>
                    </tr>
                }
                foreach (var row in category.Rows)
                {
                    <tr class="@(category.IsSectionHeader ? "" : "subtotal")">
                        <td>@row.Description</td>
                        @{ bool firstA = true; }
                        @foreach (var col in Model.Columns)
                        {
                            <td align="right" class="@(firstA ? "di-group-sep" : "")">@(row.AmountFor(col.AcademicDepartmentId).ToString("#,##0.00"))</td>
                            firstA = false;
                        }
                        <td align="right">@(row.TotalAmount.ToString("#,##0.00"))</td>
                        @{ bool firstD = true; }
                        @foreach (var col in Model.Columns)
                        {
                            <td align="right" class="@(firstD ? "di-group-sep" : "")">@(row.PostedFor(col.AcademicDepartmentId).ToString("#,##0.00"))</td>
                            firstD = false;
                        }
                        <td align="right">@(row.TotalPosted.ToString("#,##0.00"))</td>
                    </tr>
                }
                if (category.ShowSubtotal && category.Subtotal != null)
                {
                    <tr class="subtotal">
                        <td>Subtotal</td>
                        @{ bool firstAS = true; }
                        @foreach (var col in Model.Columns)
                        {
                            <td align="right" class="@(firstAS ? "di-group-sep" : "")">@(category.Subtotal.AmountFor(col.AcademicDepartmentId).ToString("#,##0.00"))</td>
                            firstAS = false;
                        }
                        <td align="right">@(category.Subtotal.TotalAmount.ToString("#,##0.00"))</td>
                        @{ bool firstDS = true; }
                        @foreach (var col in Model.Columns)
                        {
                            <td align="right" class="@(firstDS ? "di-group-sep" : "")">@(category.Subtotal.PostedFor(col.AcademicDepartmentId).ToString("#,##0.00"))</td>
                            firstDS = false;
                        }
                        <td align="right">@(category.Subtotal.TotalPosted.ToString("#,##0.00"))</td>
                    </tr>
                }
            }
            @if (Model.TotalAssessment != null)
            {
                <tr class="subtotal">
                    <td><strong>@Model.TotalAssessment.Description</strong></td>
                    @{ bool firstAT = true; }
                    @foreach (var col in Model.Columns)
                    {
                        <td align="right" class="@(firstAT ? "di-group-sep" : "")"><strong>@(Model.TotalAssessment.AmountFor(col.AcademicDepartmentId).ToString("#,##0.00"))</strong></td>
                        firstAT = false;
                    }
                    <td align="right"><strong>@(Model.TotalAssessment.TotalAmount.ToString("#,##0.00"))</strong></td>
                    @{ bool firstDT = true; }
                    @foreach (var col in Model.Columns)
                    {
                        <td align="right" class="@(firstDT ? "di-group-sep" : "")"><strong>@(Model.TotalAssessment.PostedFor(col.AcademicDepartmentId).ToString("#,##0.00"))</strong></td>
                        firstDT = false;
                    }
                    <td align="right"><strong>@(Model.TotalAssessment.TotalPosted.ToString("#,##0.00"))</strong></td>
                </tr>
            }
        </tbody>
    </table>
</div>
<p class="text-muted no-print mb-0"><small>Actual = assessed fee &nbsp;&bull;&nbsp; Deferred = computed posted amount &nbsp;&bull;&nbsp; <span class="badge bg-warning">O</span> draft &nbsp; <span class="badge bg-danger">F</span> final</small></p>
