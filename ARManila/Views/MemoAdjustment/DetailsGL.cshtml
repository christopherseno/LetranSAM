@model ARManila.Models.OtherDTO.MemoGLDTO
@{
    ViewBag.Title = "D/C Memo & Adjustments — GL Accounts";
}

<style>
    @@media print {
        body * { visibility: hidden; }
        #ma-print, #ma-print * { visibility: visible; }
        #ma-print { position: absolute; left: 0; top: 0; width: 100%; }
        .no-print { display: none !important; }
        .table { font-size: 11px; }
    }
</style>

<nav class="breadcrumb push bg-body-extra-light rounded-pill no-print">
    <span class="breadcrumb-item"><a href="@Url.Action("Index")">D/C Memo &amp; Adjustments</a></span>
    <span class="breadcrumb-item active">GL Accounts</span>
</nav>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}
@if (ViewBag.Message != null)
{
    <div class="alert alert-success">@ViewBag.Message</div>
}

@if (Model == null)
{
    <a href="@Url.Action("Index")" class="btn btn-secondary">Back to list</a>
}
else
{
    <div id="ma-print" class="block block-rounded">
        <div class="block-header block-header-default">
            <h3 class="block-title">
                @Model.PeriodName &mdash; @Model.AsOfDate.ToString("MMMM dd, yyyy")
                @if (Model.IsFinal)
                {
                    <span class="badge bg-danger">Final</span>
                }
                else
                {
                    <span class="badge bg-secondary">Draft</span>
                }
                <small class="text-muted">&nbsp;GL Accounts</small>
            </h3>
            <div class="block-options no-print">
                <a href="@Url.Action("Index")" class="btn btn-sm btn-alt-secondary" title="Back to list">
                    <i class="fa fa-arrow-left"></i>
                </a>
                <a href="@Url.Action("Details", new { date = Model.AsOfDate.ToString("yyyy-MM-dd") })" class="btn btn-sm btn-alt-secondary" title="Department matrix view">
                    <i class="fa fa-table"></i>
                </a>
                <button type="button" class="btn btn-sm btn-alt-secondary" title="Print (browser)" onclick="window.print()">
                    <i class="fa fa-print"></i>
                </button>
            </div>
        </div>
        <div class="block-content">
            <div class="fw-semibold mb-3">Month @Model.NthMonth of @Model.NoOfMonths</div>

            @foreach (var sec in Model.Sections)
            {
                <h4>@sec.Title</h4>
                <div class="table-responsive mb-4">
                    <table class="table table-striped table-bordered table-hover">
                        <thead>
                            <tr class="bg-gray-light">
                                <th>Chart of Account</th>
                                <th>QNE Account Code</th>
                                <th>Particular(s)</th>
                                <th class="text-center">Amount</th>
                                <th class="text-center">Posted</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in sec.Rows)
                            {
                                <tr>
                                    <td>
                                        @if (string.IsNullOrWhiteSpace(row.ChartOfAccount))
                                        {
                                            <span class="text-danger"><i class="fa fa-exclamation-triangle"></i> No chart of account mapped</span>
                                        }
                                        else
                                        {
                                            @row.ChartOfAccount
                                        }
                                    </td>
                                    <td>
                                        @if (string.IsNullOrWhiteSpace(row.QNECode))
                                        {
                                            <span class="text-danger"><i class="fa fa-exclamation-triangle"></i> No QNE account code</span>
                                        }
                                        else
                                        {
                                            @row.QNECode
                                        }
                                    </td>
                                    <td>@row.Particular</td>
                                    <td align="right">@row.Amount.ToString("#,##0.00")</td>
                                    <td align="right">@row.PostedAmount.ToString("#,##0.00")</td>
                                </tr>
                            }
                            <tr class="subtotal">
                                <td colspan="3"><strong>Total &mdash; @sec.Title</strong></td>
                                <td align="right"><strong>@sec.TotalAmount.ToString("#,##0.00")</strong></td>
                                <td align="right"><strong>@sec.TotalPosted.ToString("#,##0.00")</strong></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            }

            <div class="table-responsive">
                <table class="table table-bordered">
                    <tbody>
                        <tr class="subtotal">
                            <td><strong>Grand Total (all memo types)</strong></td>
                            <td align="right" style="width: 18%;"><strong>@Model.GrandAmount.ToString("#,##0.00")</strong></td>
                            <td align="right" style="width: 18%;"><strong>@Model.GrandPosted.ToString("#,##0.00")</strong></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
