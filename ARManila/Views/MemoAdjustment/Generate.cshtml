@model ARManila.Models.OtherDTO.MemoAdjustmentQueryDTO
@{
    ViewBag.Title = "Generate D/C Memo & Adjustments";
}
<nav class="breadcrumb push bg-body-extra-light rounded-pill">
    <span class="breadcrumb-item"><a href="@Url.Action("Index")">D/C Memo &amp; Adjustments</a></span>
    <span class="breadcrumb-item active">Generate</span>
</nav>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@using (Html.BeginForm("Generate", "MemoAdjustment", FormMethod.Post))
{
    <div class="row">
        <div class="form-group col-md-4">
            <label>As Of Date</label>
            <input type="date" value="@(Model != null ? Model.AsOfDate.ToString("yyyy-MM-dd") : "")" id="asofdate" name="asofdate" class="form-control" required />
        </div>
        <div class="form-group col-md-2">
            <label>Nth Month</label>
            <input type="number" min="1" value="@(Model != null ? Model.NthMonth : 1)" id="nthmonth" name="nthmonth" class="form-control" required />
        </div>
        <div class="form-group col-md-2">
            <label>No. of Months</label>
            <input type="number" min="1" value="@(Model != null ? Model.NoOfMonths : 1)" id="noofmonths" name="noofmonths" class="form-control" required />
        </div>
        <div class="form-group col-md-2">
            <label>&nbsp;</label>
            <input type="submit" value="Load" class="form-control btn btn-primary" />
        </div>
    </div>
}

@if (Model != null)
{
    <div class="block block-rounded">
        <div class="block-header block-header-default">
            <h3 class="block-title">@Model.PeriodName &mdash; As Of @Model.AsOfDate.ToString("MMMM dd, yyyy")</h3>
        </div>
        <div class="block-content">
            @if (Model.Sections.Count == 0)
            {
                <div class="alert alert-info">No memo or adjustment records found as of this date. Saving will record a <strong>zero posting</strong> for Month @Model.NthMonth of @Model.NoOfMonths.</div>
            }
            else
            {
                @Html.Partial("_MemoAdjustmentMatrix", Model)
            }

            @using (Html.BeginForm("Save", "MemoAdjustment", FormMethod.Post))
            {
                <input type="hidden" name="asofdate" value="@Model.AsOfDate.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="nthmonth" value="@Model.NthMonth" />
                <input type="hidden" name="noofmonths" value="@Model.NoOfMonths" />
                <div class="form-group push">
                    <input type="submit" value="Save as Draft" class="btn btn-success" onclick="return confirm('Save this posting as a draft? An existing non-final posting for the same date will be overridden.');" />
                </div>
            }
        </div>
    </div>
}
